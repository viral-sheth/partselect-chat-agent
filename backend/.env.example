# Copy this file to .env for local development
# On Railway: set these as environment variables in the dashboard

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local: sqlite+aiosqlite:///./partselect.db
# Railway (with volume mounted at /data): sqlite+aiosqlite:////data/partselect.db
DATABASE_URL=sqlite+aiosqlite:///./partselect.db

# Local: ./chroma_db
# Railway (with volume mounted at /data): /data/chroma_db
CHROMA_DB_PATH=./chroma_db

EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local: ["http://localhost:3000"]
# Railway: ["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]
